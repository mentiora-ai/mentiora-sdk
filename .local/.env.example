# Mentiora SDK — Local Environment Variables
# Copy this file to .local/.env and fill in your real values:
#   cp .local/.env.example .local/.env
#
# These variables are exported by run-examples.sh and take precedence
# over per-example .env files (because dotenv uses override=false).

# Required for all examples
MENTIORA_API_KEY=your-api-key-here
MENTIORA_BASE_URL=https://platform.mentiora.ai

# Required for openai-integration and langchain-integration examples
OPENAI_API_KEY=your-openai-api-key-here

# Optional — agent-run example (defaults to "production")
# MENTIORA_AGENT_TAG=production
