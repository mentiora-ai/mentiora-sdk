{
  "name": "@mentiora.ai/sdk",
  "version": "0.3.0",
  "description": "Official SDK for the Mentiora platform - AI observability and tracing",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./openai": {
      "import": {
        "types": "./dist/plugins/openai.d.ts",
        "default": "./dist/plugins/openai.js"
      },
      "require": {
        "types": "./dist/plugins/openai.d.cts",
        "default": "./dist/plugins/openai.cjs"
      }
    },
    "./langchain": {
      "import": {
        "types": "./dist/plugins/langchain.d.ts",
        "default": "./dist/plugins/langchain.js"
      },
      "require": {
        "types": "./dist/plugins/langchain.d.cts",
        "default": "./dist/plugins/langchain.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui/index.d.ts",
        "default": "./dist/ui/index.js"
      },
      "require": {
        "types": "./dist/ui/index.d.cts",
        "default": "./dist/ui/index.cjs"
      }
    },
    "./ui/headless": {
      "import": {
        "types": "./dist/ui/headless.d.ts",
        "default": "./dist/ui/headless.js"
      },
      "require": {
        "types": "./dist/ui/headless.d.cts",
        "default": "./dist/ui/headless.cjs"
      }
    },
    "./ui/themes": {
      "import": {
        "types": "./dist/ui/themes.d.ts",
        "default": "./dist/ui/themes.js"
      },
      "require": {
        "types": "./dist/ui/themes.d.cts",
        "default": "./dist/ui/themes.cjs"
      }
    },
    "./ui/styles.css": "./dist/ui/themes/base.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mentiora",
    "sdk",
    "typescript",
    "tracing",
    "observability",
    "ai",
    "llm",
    "monitoring",
    "openai",
    "langchain",
    "javascript",
    "chat-widget",
    "chatbot",
    "react"
  ],
  "author": "Mentiora",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/mentiora-ai/mentiora-sdk/tree/main/typescript#readme",
  "bugs": {
    "url": "https://github.com/mentiora-ai/mentiora-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mentiora-ai/mentiora-sdk.git",
    "directory": "typescript"
  },
  "scripts": {
    "build": "tsup && mkdir -p dist/ui/themes && cp src/ui/themes/base.css dist/ui/themes/base.css",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md,css}\"",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "*.{ts,tsx,json,md,css}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.1.0",
    "openai": ">=6.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.1.16",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "openai": "^6.16.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "uuid": "^13.0.0"
  }
}
