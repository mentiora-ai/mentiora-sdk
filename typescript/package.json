{
  "name": "@mentiora.ai/sdk",
  "version": "0.2.0",
  "description": "Official SDK for the Mentiora platform - AI observability and tracing",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mentiora",
    "sdk",
    "typescript",
    "tracing",
    "observability",
    "ai",
    "llm",
    "monitoring",
    "openai",
    "langchain",
    "javascript"
  ],
  "author": "Mentiora",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/mentiora-ai/mentiora-sdk/tree/main/typescript#readme",
  "bugs": {
    "url": "https://github.com/mentiora-ai/mentiora-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mentiora-ai/mentiora-sdk.git",
    "directory": "typescript"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "*.{ts,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.1.0",
    "openai": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.1.16",
    "@types/node": "^25.0.9",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "openai": "^6.16.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "uuid": "^13.0.0"
  }
}
